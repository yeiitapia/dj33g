# Copia este archivo como .env y llena tus valores. Nunca subas el .env real.
PORT=3000
DB_PATH=./data/dj33g.db
# Mercado Pago (opcional: sin estas claves, los trámites quedan "pendiente de pago"
# y el administrador los confirma manualmente).
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Alerta de WhatsApp al administrador cuando se solicita un acta (CallMeBot).
# Sin CALLMEBOT_APIKEY no se envía nada. ADMIN_WHATSAPP es tu número con clave
# de país (52 = México). Para activar CallMeBot, mándale un WhatsApp al bot
# con el texto "I allow callmebot to send me messages" y te dará tu apikey.
ADMIN_WHATSAPP=527774700718
CALLMEBOT_APIKEY=
